# Meridian Environment Variables
# Copy this file to .env.local and fill in your values

# Serper.dev API Key — https://serper.dev
SERPER_API_KEY=

# ── AI Models ────────────────────────────────────────────────────────────────

# Groq — https://console.groq.com (required, used for Strategic + Synthesis)
GROQ_API_KEY=

# DeepSeek — https://platform.deepseek.com (Financial Analysis primary model)
DEEPSEEK_API_KEY=

# Google Gemini — https://aistudio.google.com (Market Intelligence primary model)
GEMINI_API_KEY=

# Mistral — https://console.mistral.ai (Market Intelligence fallback)
MISTRAL_API_KEY=

# Note: Triangulation works with only GROQ_API_KEY set.
# Add DEEPSEEK_API_KEY, GEMINI_API_KEY, MISTRAL_API_KEY for full multi-model analysis.
# Models fall back gracefully when keys are missing or rate-limited.

# ── Supabase ─────────────────────────────────────────────────────────────────
# https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App config ────────────────────────────────────────────────────────────────
# App URL (for cron and share links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron secret (generate a random string, e.g. openssl rand -hex 32)
CRON_SECRET=
